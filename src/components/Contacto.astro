---
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";

const socialLinks = [
  {
    name: "YouTube",
    url: "https://www.youtube.com/@CiudadCulturalProducciones",
    icon: `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  },
];

const fieldClass =
  "w-full px-4 py-3 bg-background-secondary border border-border rounded-lg text-white placeholder-text-secondary focus:border-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary transition-colors duration-200";
---

<section id="contacto" class="py-20 bg-background-primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-gaming font-bold text-white mb-6">Contacto</h2>
      <div class="w-24 h-1 bg-gradient-to-r from-primary to-secondary mx-auto"></div>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <div>
        <h3 class="text-2xl md:text-3xl font-gaming font-bold text-primary mb-4">
          Envíanos un Mensaje
        </h3>
        <p class="text-text-secondary mb-8">
          Completa el formulario y te responderemos a la brevedad.
        </p>
        <form id="contact-form" class="space-y-6" novalidate>
          <input type="hidden" name="access_key" value={accessKey} />
          <input type="hidden" name="from_name" value="CREADORES — Sitio web" />
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="nombre" class="block text-text-secondary font-medium mb-2">Nombre</label>
              <input type="text" id="nombre" name="name" class={fieldClass} placeholder="Tu nombre" required autocomplete="name" />
            </div>
            <div>
              <label for="email" class="block text-text-secondary font-medium mb-2">Email</label>
              <input type="email" id="email" name="email" class={fieldClass} placeholder="tu@email.com" required autocomplete="email" />
            </div>
          </div>
          <div>
            <label for="asunto" class="block text-text-secondary font-medium mb-2">Asunto</label>
            <select id="asunto" name="asunto" class={fieldClass} required>
              <option value="">Selecciona un asunto</option>
              <option value="Consulta General">Consulta General</option>
              <option value="Solicitud de Prensa">Solicitud de Prensa</option>
              <option value="Colaboración">Colaboración</option>
              <option value="Kit de Medios">Kit de Medios</option>
            </select>
          </div>
          <div>
            <label for="mensaje" class="block text-text-secondary font-medium mb-2">Mensaje</label>
            <textarea id="mensaje" name="message" rows="6" class={`${fieldClass} resize-none`} placeholder="Escribe tu mensaje aquí..." required></textarea>
          </div>
          <p id="contact-form-status" class="text-sm text-text-secondary" role="status" aria-live="polite"></p>
          <button
            type="submit"
            id="contact-form-submit"
            class="w-full min-h-11 px-8 py-3.5 bg-primary hover:brightness-110 text-on-primary font-bold text-lg rounded-lg transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <span class="flex items-center justify-center space-x-2">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M3 3a1 1 0 000 2v8a2 2 0 002 2h2.586l-1.293 1.293a1 1 0 101.414 1.414L10 15.414l2.293 2.293a1 1 0 001.414-1.414L12.414 15H15a2 2 0 002-2V5a1 1 0 100-2H3zm11.707 4.707a1 1 0 00-1.414-1.414L10 9.586 8.707 8.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span id="contact-form-submit-label">Enviar mensaje</span>
            </span>
          </button>
        </form>
      </div>

      <div class="space-y-8">
        <div>
          <h3 class="text-2xl md:text-3xl font-gaming font-bold text-secondary mb-8">
            Información de Contacto
          </h3>
          <div class="space-y-6">
            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-on-primary" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                </svg>
              </div>
              <div>
                <div class="text-white font-bold">Email</div>
                <a href="mailto:ciudadcultural.cl@gmail.com" class="text-primary hover:underline break-all">
                  ciudadcultural.cl@gmail.com
                </a>
              </div>
            </div>
            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 bg-secondary rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-on-secondary" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                </svg>
              </div>
              <div>
                <div class="text-white font-bold">Teléfono</div>
                <a href="tel:+56963047502" class="text-primary hover:underline">+56 9 6304 7502</a>
              </div>
            </div>
            <div class="flex items-center space-x-4">
              <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-on-primary" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                </svg>
              </div>
              <div>
                <div class="text-white font-bold">Empresa</div>
                <div class="text-text-secondary">Ciudad Cultural Producciones Spa</div>
              </div>
            </div>
          </div>
        </div>

        <div>
          <h4 class="text-xl font-gaming font-bold text-white mb-6">Síguenos</h4>
          <div class="flex space-x-4">
            {socialLinks.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 min-w-11 min-h-11 bg-background-secondary border border-border rounded-lg flex items-center justify-center text-text-secondary hover:text-primary hover:border-primary transition-colors duration-200"
                aria-label={social.name}
              >
                <Fragment set:html={social.icon} />
              </a>
            ))}
          </div>
        </div>

        <div>
          <h4 class="text-xl font-gaming font-bold text-white mb-6">Enlaces Rápidos</h4>
          <div class="space-y-3">
            <a href="#sobre" class="flex items-center space-x-3 text-text-secondary hover:text-primary transition-colors duration-200 min-h-11">
              <span>Sobre la Serie</span>
            </a>
            <a href="#medios" class="flex items-center space-x-3 text-text-secondary hover:text-primary transition-colors duration-200 min-h-11">
              <span>Galería de Medios</span>
            </a>
            <a href="#prensa" class="flex items-center space-x-3 text-text-secondary hover:text-primary transition-colors duration-200 min-h-11">
              <span>Información de Prensa</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-form-status');
  const submitBtn = document.getElementById('contact-form-submit') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('contact-form-submit-label');

  const setStatus = (message: string, tone: 'neutral' | 'success' | 'error' = 'neutral') => {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('text-text-secondary', 'text-success', 'text-error');
    if (tone === 'success') status.classList.add('text-success');
    else if (tone === 'error') status.classList.add('text-error');
    else status.classList.add('text-text-secondary');
  };

  const setLoading = (loading: boolean) => {
    if (submitBtn) submitBtn.disabled = loading;
    if (submitLabel) submitLabel.textContent = loading ? 'Enviando…' : 'Enviar mensaje';
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      setStatus('Revisa los campos marcados e inténtalo de nuevo.', 'error');
      return;
    }

    const accessKeyInput = form.querySelector('input[name="access_key"]') as HTMLInputElement | null;
    if (!accessKeyInput?.value) {
      setStatus(
        'El formulario aún no está configurado. Agrega PUBLIC_WEB3FORMS_ACCESS_KEY en las variables de entorno.',
        'error',
      );
      return;
    }

    const asunto = String(new FormData(form).get('asunto') || '').trim();
    const payload = new FormData(form);
    payload.set('subject', `CREADORES — ${asunto}`);

    setLoading(true);
    setStatus('Enviando tu mensaje…');

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: payload,
      });
      const result = (await response.json()) as { success?: boolean; message?: string };

      if (response.ok && result.success) {
        form.reset();
        setStatus('Mensaje enviado. Te responderemos pronto.', 'success');
      } else {
        setStatus(result.message || 'No se pudo enviar el mensaje. Inténtalo de nuevo.', 'error');
      }
    } catch {
      setStatus('Error de conexión. Revisa tu internet e inténtalo de nuevo.', 'error');
    } finally {
      setLoading(false);
    }
  });
</script>
