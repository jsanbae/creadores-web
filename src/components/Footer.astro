---
const currentYear = new Date().getFullYear();
const socialLinks = [
  {
    name: "YouTube",
    url: "https://www.youtube.com/@CiudadCulturalProducciones",
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  },
];
---

<footer class="bg-background-secondary border-t border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid md:grid-cols-4 gap-8">
      <div class="md:col-span-2">
        <div class="flex items-center space-x-2 mb-4">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center">
            <img
              src="/images/logos/logo_creadores.png"
              alt="Logo de CREADORES"
              class="w-full h-full object-contain"
              width="32"
              height="32"
            />
          </div>
          <span class="text-white font-gaming font-bold text-xl">CREADORES</span>
        </div>
        <p class="text-text-secondary mb-6 max-w-md">
          Una serie documental sobre los desarrolladores de videojuegos en Chile.
          Sigue el proceso creativo de los desarrolladores chilenos, sus sueños y frustraciones.
        </p>
        <div class="flex space-x-4">
          {socialLinks.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="w-11 h-11 bg-background-primary border border-border rounded-lg flex items-center justify-center text-text-secondary hover:text-primary hover:border-primary transition-colors duration-200"
              aria-label={social.name}
            >
              <Fragment set:html={social.icon} />
            </a>
          ))}
        </div>
      </div>

      <div>
        <h4 class="text-white font-gaming font-bold mb-4">Enlaces</h4>
        <ul class="space-y-2">
          <li><a href="#sobre" class="text-text-secondary hover:text-primary transition-colors duration-200 inline-flex min-h-11 items-center">Sobre la Serie</a></li>
          <li><a href="#capitulos" class="text-text-secondary hover:text-primary transition-colors duration-200 inline-flex min-h-11 items-center">Capítulos</a></li>
          <li><a href="#produccion" class="text-text-secondary hover:text-primary transition-colors duration-200 inline-flex min-h-11 items-center">Producción</a></li>
          <li><a href="#equipo" class="text-text-secondary hover:text-primary transition-colors duration-200 inline-flex min-h-11 items-center">Equipo</a></li>
          <li><a href="#medios" class="text-text-secondary hover:text-primary transition-colors duration-200 inline-flex min-h-11 items-center">Medios</a></li>
          <li><a href="#prensa" class="text-text-secondary hover:text-primary transition-colors duration-200 inline-flex min-h-11 items-center">Prensa</a></li>
          <li><a href="#contacto" class="text-text-secondary hover:text-primary transition-colors duration-200 inline-flex min-h-11 items-center">Contacto</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-white font-gaming font-bold mb-4">Contacto</h4>
        <div class="space-y-3 text-text-secondary">
          <div>
            <div class="font-medium text-white">Email</div>
            <a href="mailto:ciudadcultural.cl@gmail.com" class="text-primary hover:underline break-all">
              ciudadcultural.cl@gmail.com
            </a>
          </div>
          <div>
            <div class="font-medium text-white">Teléfono</div>
            <a href="tel:+56963047502" class="text-primary hover:underline">+56 9 6304 7502</a>
          </div>
          <div>
            <div class="font-medium text-white">Empresa</div>
            <div>Ciudad Cultural Producciones Spa</div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-border">
      <div class="text-center">
        <h4 class="text-white font-gaming font-bold mb-6">Con el Apoyo de</h4>
        <div class="flex flex-col md:flex-row items-center justify-center gap-4">
          <a
            href="https://www.cultura.gob.cl/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 min-h-11"
          >
            <img
              src="/images/logos/Logo_del_Ministerio_de_las_Culturas,_las_Artes_y_el_Patrimonio_de_Chile.png"
              alt="Logo del Ministerio de las Culturas, las Artes y el Patrimonio de Chile"
              class="object-contain w-12 h-12"
              loading="lazy"
              width="48"
              height="48"
            />
            <span class="text-text-secondary font-medium text-left">
              Ministerio de las Culturas, las Artes y el Patrimonio
            </span>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-border">
      <div class="text-text-secondary text-sm text-center md:text-left">
        © {currentYear} Ciudad Cultural Producciones Spa. Todos los derechos reservados.
      </div>
    </div>
  </div>
</footer>
