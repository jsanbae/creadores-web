---
const pressRelease = {
  title: "La Webserie 'Creadores' consigue financiamiento del Ministerio de las Culturas para su primera temporada",
  date: "2023",
  excerpt:
    "El proyecto documental sobre desarrolladores de videojuegos chilenos recibe apoyo del Fondo Audiovisual para su producción.",
};

const mediaKit = {
  title: "Kit de Medios",
  description: "Material disponible bajo solicitud a la productora (no hay descarga directa en este sitio).",
  items: [
    "Notas de prensa",
    "Imágenes de alta resolución",
    "Logos oficiales",
    "Información de contacto para entrevistas",
  ],
};
---

<section id="prensa" class="py-20 bg-background-secondary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-gaming font-bold text-white mb-6">Prensa</h2>
      <div class="w-24 h-1 bg-gradient-to-r from-primary to-secondary mx-auto"></div>
    </div>

    <div class="mb-16">
      <h3 class="text-2xl md:text-3xl font-gaming font-bold text-primary mb-8 text-center">
        Comunicados de Prensa
      </h3>
      <div class="bg-background-primary rounded-lg p-8 border border-border">
        <div class="flex items-start space-x-4">
          <div class="w-12 h-12 bg-primary rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-on-primary" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M4 4a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2H4zm3 2h6v4H7V6zm8 8H5v-2h10v2z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center gap-3 mb-2">
              <span class="text-primary font-bold">{pressRelease.date}</span>
              <span class="px-3 py-1 bg-primary text-on-primary text-xs font-bold rounded-full">
                Financiamiento confirmado
              </span>
            </div>
            <h4 class="text-xl font-gaming font-bold text-white mb-3">{pressRelease.title}</h4>
            <p class="text-text-secondary mb-4">{pressRelease.excerpt}</p>
            <p class="text-text-secondary text-sm mb-4">
              El texto completo del comunicado se entrega a medios bajo solicitud.
            </p>
            <a
              href="#contacto"
              class="inline-flex min-h-11 items-center text-primary hover:underline font-bold"
            >
              Solicitar el comunicado por contacto
            </a>
          </div>
        </div>
      </div>
    </div>

    <div>
      <h3 class="text-2xl md:text-3xl font-gaming font-bold text-secondary mb-8 text-center">
        Información para Medios
      </h3>
      <div class="grid lg:grid-cols-2 gap-8">
        <div class="bg-background-primary rounded-lg p-8 border border-border">
          <div class="text-center mb-6">
            <div class="w-16 h-16 bg-secondary rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-on-secondary" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM6.293 6.707a1 1 0 010-1.414l3-3a1 1 0 011.414 0l3 3a1 1 0 01-1.414 1.414L11 5.414V13a1 1 0 11-2 0V5.414L7.707 6.707a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
            </div>
            <h4 class="text-xl font-gaming font-bold text-white mb-2">{mediaKit.title}</h4>
            <p class="text-text-secondary">{mediaKit.description}</p>
          </div>
          <ul class="space-y-3">
            {mediaKit.items.map((item) => (
              <li class="flex items-center space-x-3">
                <div class="w-2 h-2 bg-primary rounded-full shrink-0" aria-hidden="true"></div>
                <span class="text-text-secondary">{item}</span>
              </li>
            ))}
          </ul>
          <div class="mt-6 text-center">
            <a
              href="#contacto"
              class="inline-flex min-h-11 items-center px-6 py-3 bg-secondary hover:brightness-110 text-on-secondary font-bold rounded-lg transition-colors duration-200"
            >
              Solicitar Kit de Medios
            </a>
          </div>
        </div>

        <div class="bg-background-primary rounded-lg p-8 border border-border">
          <div class="text-center mb-6">
            <div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-on-primary" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-6-3a2 2 0 11-4 0 2 2 0 014 0zm-2 4a5 5 0 00-4.546 2.916A5.986 5.986 0 0010 16a5.986 5.986 0 004.546-2.084A5 5 0 0010 11z" clip-rule="evenodd" />
              </svg>
            </div>
            <h4 class="text-xl font-gaming font-bold text-white mb-2">Contacto para Medios</h4>
            <p class="text-text-secondary">Para entrevistas, citas y envío de material</p>
          </div>
          <div class="space-y-4">
            <div>
              <div class="text-white font-bold">Email</div>
              <a href="mailto:ciudadcultural.cl@gmail.com" class="text-primary hover:underline break-all">
                ciudadcultural.cl@gmail.com
              </a>
            </div>
            <div>
              <div class="text-white font-bold">Teléfono</div>
              <a href="tel:+56963047502" class="text-primary hover:underline">+56 9 6304 7502</a>
            </div>
            <div>
              <div class="text-white font-bold">Empresa</div>
              <div class="text-text-secondary">Ciudad Cultural Producciones Spa</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
